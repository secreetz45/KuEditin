<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <!-- Dedicated Background Mesh View (Login Style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mesh_blur" />

    <!-- Subtle Texture Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dot_pattern"
        android:alpha="0.08" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="60dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Premium Gradient Header Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_home_header"
                android:clipChildren="false">

                <!-- Decorative Background Glow Circle -->
                <View
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-40dp"
                    android:layout_marginRight="-40dp"
                    android:alpha="0.15"
                    android:background="@drawable/circle_blue_soft" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="48dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp">

                        <ImageView
                            android:id="@+id/btn_back"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/circle_white_elevated"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_back_ios"
                            app:tint="@color/colorPrimary" />

                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Penarikan Uang &amp; Saldo"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cairkan saldo hasil pengerjaan proyek ke e-wallet &amp; rekening bank"
                        android:textColor="#DBEAFE"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card 1: Balance Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="-40dp"
                android:outlineAmbientShadowColor="#1A000000"
                android:outlineSpotShadowColor="#1A000000"
                android:translationZ="4dp"
                app:cardBackgroundColor="@color/cardSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/borderLight"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo Dompet Tersedia"
                        android:textColor="@color/textMuted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txt_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rp0"
                        android:textColor="@color/colorPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Form Penarikan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/cardSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/borderLight"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Metode / Channel Penarikan *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- E-Wallet Row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="E-Wallet (DANA, GoPay, OVO, ShopeePay)"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_dana"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/bg_chip_selected"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="DANA"
                                android:textColor="@color/colorPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/chip_gopay"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="GoPay"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/chip_ovo"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="OVO"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/chip_shopeepay"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="ShopeePay"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Bank Row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Transfer Bank (BCA, Mandiri, BRI, BNI)"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_bca"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="Bank BCA"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/chip_mandiri"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="Bank Mandiri"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/chip_bri"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="Bank BRI"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/chip_bni"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="Bank BNI"
                                android:textColor="@color/textMuted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Nominal Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Nominal Penarikan (Rp) *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_amount"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="Contoh: 100000"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:singleLine="true"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textMuted"
                        android:textSize="14sp" />

                    <!-- Nomor Rekening / HP Input -->
                    <TextView
                        android:id="@+id/txt_account_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Nomor DANA / No. Rekening Tujuan *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_account"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="Nomor HP DANA / Rekening Bank"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:singleLine="true"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textMuted"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="40dp"
                android:outlineAmbientShadowColor="#5D63FF"
                android:outlineSpotShadowColor="#5D63FF"
                android:translationZ="4dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/btn_submit_withdrawal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="Ajukan Penarikan Uang"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
