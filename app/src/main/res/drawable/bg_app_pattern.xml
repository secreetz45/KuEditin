<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#F1F5F9" />
        </shape>
    </item>
    <!-- Subtle circles for background texture -->
    <item android:top="-100dp" android:right="-100dp">
        <shape android:shape="oval">
            <solid android:color="#E2E8F0" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>
    <item android:bottom="-50dp" android:left="-80dp">
        <shape android:shape="oval">
            <solid android:color="#E2E8F0" />
            <size android:width="250dp" android:height="250dp" />
        </shape>
    </item>
</layer-list>
