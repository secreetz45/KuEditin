<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sophisticated Multi-Layer Mesh Gradient (Vibrant & Harmonious) -->

    <!-- Base Layer -->
    <item>
        <shape>
            <solid android:color="#F8FAFF" />
        </shape>
    </item>

    <!-- Brand Violet Glow (Top Left) -->
    <item>
        <shape>
            <gradient
                android:centerX="5%"
                android:centerY="5%"
                android:gradientRadius="800dp"
                android:startColor="#26783afd"
                android:type="radial" />
        </shape>
    </item>

    <!-- Royal Blue Glow (Right Top) -->
    <item>
        <shape>
            <gradient
                android:centerX="100%"
                android:centerY="20%"
                android:gradientRadius="900dp"
                android:startColor="#1A2563EB"
                android:type="radial" />
        </shape>
    </item>

    <!-- Emerald Bloom (Center Bottom) -->
    <item>
        <shape>
            <gradient
                android:centerX="50%"
                android:centerY="100%"
                android:gradientRadius="1000dp"
                android:startColor="#0D10B981"
                android:type="radial" />
        </shape>
    </item>

    <!-- Soft Rose Glow (Left Bottom) -->
    <item>
        <shape>
            <gradient
                android:centerX="15%"
                android:centerY="85%"
                android:gradientRadius="700dp"
                android:startColor="#12EB4899"
                android:type="radial" />
        </shape>
    </item>

    <!-- Smooth Blending Overlay -->
    <item>
        <shape>
            <gradient
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="1200dp"
                android:startColor="#33FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
