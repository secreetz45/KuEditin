<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sophisticated Glassmorphism Effect -->

    <!-- Shadow/Outer Glow -->
    <item>
        <shape>
            <solid android:color="#0D000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Frosted Surface Layer -->
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#B3FFFFFF"
                android:centerColor="#99FFFFFF"
                android:endColor="#80FFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Glossy Highlight Border (Inner) -->
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Sharp Outer Edge -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
