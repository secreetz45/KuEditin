<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_gravity="bottom"
    android:elevation="30dp"
    android:translationZ="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <!-- Pill Container -->
    <FrameLayout
        android:id="@+id/nav_pill_container"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_pill"
            android:elevation="10dp" />

        <!-- Blue Glass Indicator - Set invisible by default to prevent flicker -->
        <View
            android:id="@+id/nav_indicator"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/nav_indicator_glass"
            android:elevation="12dp"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_nav_home"
                android:drawablePadding="-6dp"
                android:gravity="center"
                android:paddingTop="16dp"
                android:text="@string/nav_home"
                android:textColor="@color/textMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nav_order"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_nav_order"
                android:drawablePadding="-6dp"
                android:gravity="center"
                android:paddingTop="16dp"
                android:text="@string/nav_order"
                android:textColor="@color/textMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nav_chat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_nav_chat"
                android:drawablePadding="-6dp"
                android:gravity="center"
                android:paddingTop="16dp"
                android:text="@string/nav_chat"
                android:textColor="@color/textMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_nav_profile"
                android:drawablePadding="-6dp"
                android:gravity="center"
                android:paddingTop="16dp"
                android:text="@string/nav_profile"
                android:textColor="@color/textMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
