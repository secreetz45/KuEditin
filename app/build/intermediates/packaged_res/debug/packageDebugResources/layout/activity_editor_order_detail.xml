<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <!-- Dedicated Background Mesh View (Login Style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mesh_blur" />

    <!-- Subtle Texture Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dot_pattern"
        android:alpha="0.08" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="60dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Premium Gradient Header Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_home_header"
                android:clipChildren="false">

                <!-- Decorative Background Glow Circle -->
                <View
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-40dp"
                    android:layout_marginRight="-40dp"
                    android:alpha="0.15"
                    android:background="@drawable/circle_blue_soft" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="48dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp">

                        <ImageView
                            android:id="@+id/btn_back"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/circle_white_elevated"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_back_ios"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/txt_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_chip"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="Status Order"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Detail Proyek Editor"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rincian pesanan, instruksi brief, bahan, dan pengiriman hasil"
                        android:textColor="#DBEAFE"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Main Card Container with Spacious Section Layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/cardSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/borderLight"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- SECTION 1: Project Title & Client Info -->
                    <TextView
                        android:id="@+id/txt_editor_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Judul Proyek"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_editor_client"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pemesan: Client"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/borderLight" />

                    <!-- SECTION 2: Package & Price Breakdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Paket Jasa"
                                android:textColor="@color/textMuted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txt_editor_package"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Paket Standar"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Harga Proyek"
                                android:textColor="@color/textMuted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txt_editor_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp0"
                                android:textColor="@color/textMuted"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Net Revenue Breakdown Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pendapatan Bersih (Net 90%)"
                            android:textColor="@color/textMuted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txt_editor_net_revenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp0"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/borderLight" />

                    <!-- SECTION 3: Brief & Materials -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brief &amp; Instruksi Client"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_editor_brief"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:autoLink="web"
                        android:textIsSelectable="true"
                        android:text="-"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />

                    <!-- File Bahan Button (Pill Style) -->
                    <LinearLayout
                        android:id="@+id/btn_open_bahan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txt_open_bahan_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buka / Download File Bahan"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Open Cloud Material Link Button -->
                    <LinearLayout
                        android:id="@+id/btn_open_cloud_link"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txt_open_cloud_link_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buka Link Bahan Cloud (Drive / Link)"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Copy Cloud Link Button -->
                    <LinearLayout
                        android:id="@+id/btn_copy_cloud_link"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salin Link Bahan ke Clipboard"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/borderLight" />

                    <!-- SECTION 4: Action Buttons & Upload Result -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status &amp; Pengiriman Hasil Proyek"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Status Action Buttons Row -->
                    <LinearLayout
                        android:id="@+id/layout_status_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_action_accept"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginRight="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Konfirmasi Order"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_action_review"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginRight="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Siap Review"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_action_finish"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Selesaikan Proyek"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Revision Notice Container -->
                    <LinearLayout
                        android:id="@+id/btn_accept_revision_container"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/btn_accept_revision"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terima Revisi &amp; Kerjakan Ulang"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Upload Result Button -->
                    <LinearLayout
                        android:id="@+id/btn_upload_result"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload / Kirim File Hasil"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Send Result via Cloud Link Button (Drive/YouTube) -->
                    <LinearLayout
                        android:id="@+id/btn_send_result_link"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kirim Hasil via Link Cloud (Drive / YouTube)"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Open Result File Button -->
                    <LinearLayout
                        android:id="@+id/btn_open_result"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txt_open_result_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lihat File Hasil"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
